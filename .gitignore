# ============================================================
# 通用 .gitignore 模板
# 这是一个覆盖面较广的起点，请按你的实际技术栈删减无关部分。
# 原则：凡是「可再生成」的产物都不要提交，只提交源码与配置。
# ============================================================

# ---------- 依赖 / 包管理器 ----------
node_modules/
bower_components/
jspm_packages/
.pnpm-store/
vendor/
packages/*/node_modules/

# ---------- 构建产物 / 编译输出 ----------
dist/
build/
out/
target/
bin/
obj/
*.o
*.a
*.so
*.dylib
*.dll
*.exe
*.class
*.jar
*.war
*.pyc
.next/
.nuxt/
.output/
.gradle/
.m2/

# ---------- 缓存 ----------
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.sass-cache/
.turbo/
.vite/
.vitest/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
.coverage
htmlcov/
coverage/
*.lcov

# ---------- 虚拟环境 ----------
.venv/
venv/
env/
ENV/
env.bak/
.conda/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
pip-wheel-metadata/

# ---------- 日志 / 临时文件 ----------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
*.swp
*.swo
*~
.idea/
*.iml
.generated/

# ---------- 运行期数据 / 本地状态 ----------
*.db
*.sqlite
*.sqlite3
*.pid
*.seed
*.pid.lock
.DS_Store
Thumbs.db
desktop.ini

# ---------- 密钥 / 凭据 / 环境变量（最重要）----------
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
credentials.json
service-account*.json
secrets.yml
secrets.yaml
.netrc

# ---------- 编辑器 / IDE ----------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.sublime-workspace
*.code-workspace

# ---------- 系统 / 打包产物 ----------
*.deb
*.rpm
*.AppImage
*.snap
*.dmg
*.iso

# ---------- Agent / AI 工具本地文件 ----------
.dsh/
.cc-switch/
.codex/
.opencode/
.copilot/
