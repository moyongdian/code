/* 首页样式 —— 极简科技风 */
.page { padding-bottom: 40rpx; }

/* ---------- 顶部 ---------- */
.topbar {
  padding: var(--sp-3) var(--sp-3) var(--sp-2);
  background: linear-gradient(180deg, rgba(34,211,238,0.07), transparent);
}

.brand { display: flex; align-items: center; margin-bottom: var(--sp-3); }

.brand-mark {
  width: 64rpx; height: 64rpx;
  border-radius: var(--r-md);
  background: var(--grad-accent);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4rpx 18rpx var(--accent-glow);
}

.brand-text { margin-left: var(--sp-2); }
.brand-name {
  display: block;
  font-size: var(--fs-xl);
  font-weight: 700;
  letter-spacing: 1rpx;
}
.brand-sub {
  display: block;
  font-size: 18rpx;
  color: var(--text-3);
  letter-spacing: 3rpx;
  margin-top: 2rpx;
}

.search-wrap {
  display: flex; align-items: center;
  height: 76rpx;
  padding: 0 var(--sp-3);
  background: var(--surface-2);
  border: 1rpx solid var(--border);
  border-radius: var(--r-pill);
}
.search-ph {
  flex: 1;
  margin-left: var(--sp-2);
  color: var(--text-3);
  font-size: var(--fs-sm);
}
.search-key {
  width: 52rpx; height: 52rpx;
  border-radius: 50%;
  background: var(--accent-soft);
  display: flex; align-items: center; justify-content: center;
}

/* ---------- 轮播 ---------- */
.banner {
  height: 260rpx;
  margin: var(--sp-3) var(--sp-3) 0;
  border-radius: var(--r-lg);
  overflow: hidden;
  border: 1rpx solid var(--border);
}
.banner-img { width: 100%; height: 100%; }

.notice-wrap { margin: var(--sp-3) var(--sp-3) 0; border-radius: var(--r-md); overflow: hidden; }

.block-more {
  margin-left: auto;
  font-size: var(--fs-sm);
  font-weight: 400;
  color: var(--text-3);
}

/* ---------- 分类网格 ---------- */
.grid-wrap {
  display: flex;
  flex-wrap: wrap;
  padding: 0 var(--sp-2);
}
.cate {
  width: 25%;
  padding: var(--sp-2) 0;
  display: flex; flex-direction: column; align-items: center;
}
.cate-icon {
  width: 96rpx; height: 96rpx;
  border-radius: var(--r-lg);
  background: var(--surface);
  border: 1rpx solid var(--border);
  display: flex; align-items: center; justify-content: center;
}
.cate-name {
  margin-top: 12rpx;
  font-size: var(--fs-sm);
  color: var(--text-2);
  max-width: 150rpx;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}

/* ---------- 骨架 ---------- */
.sk-card {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: var(--r-lg);
  padding: var(--sp-3);
  margin-bottom: var(--sp-3);
}

/* ---------- 商家卡片 ---------- */
.shop {
  display: flex;
  align-items: center;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: var(--r-lg);
  padding: var(--sp-3);
  margin-bottom: var(--sp-3);
}

.shop-logo {
  width: 132rpx; height: 132rpx;
  border-radius: var(--r-md);
  background: var(--surface-2);
  flex-shrink: 0;
}
.shop-logo-ph {
  display: flex; align-items: center; justify-content: center;
  border: 1rpx solid var(--border);
}

.shop-main { flex: 1; margin: 0 var(--sp-2); min-width: 0; }

.shop-name { font-size: var(--fs-lg); font-weight: 600; max-width: 320rpx; }

.shop-open { display: flex; align-items: center; flex-shrink: 0; }
.shop-open .dot {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: var(--text-3); margin-right: 8rpx;
}
.shop-open.on .dot { background: var(--success); box-shadow: 0 0 12rpx var(--success); }
.shop-open text { font-size: var(--fs-xs); color: var(--text-3); }
.shop-open.on text { color: var(--success); }

.shop-meta {
  display: flex; align-items: center;
  margin-top: 12rpx;
  font-size: var(--fs-xs);
  color: var(--text-3);
}
.rate { display: flex; align-items: center; }
.rate-num { margin-left: 6rpx; color: var(--warn); font-weight: 600; }
.meta-sep { margin: 0 12rpx; opacity: 0.4; }

.shop-tags { margin-top: 12rpx; }
.shop-tags .tag { margin-right: 10rpx; }

.shop-addr {
  display: flex; align-items: center;
  margin-top: 12rpx;
  font-size: var(--fs-xs);
  color: var(--text-3);
  min-width: 0;
}
.shop-addr text { margin-left: 6rpx; }

/* ---------- 列表结束标记 ---------- */
.foot {
  display: flex; align-items: center; justify-content: center;
  padding: var(--sp-4) var(--sp-5);
  color: var(--text-3);
  font-size: 18rpx;
  letter-spacing: 3rpx;
}
.foot-line {
  flex: 1; height: 1rpx;
  background: var(--border);
  margin: 0 var(--sp-2);
}
