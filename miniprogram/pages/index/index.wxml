<view class="page">
  <!-- 顶部搜索 -->
  <view class="search-bar">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索商品、商家" placeholder-class="search-ph"
             value="{{keyword}}" bindinput="onSearchInput" confirm-type="search"
             bindconfirm="onSearchConfirm" />
    </view>
    <text class="search-btn" bindtap="onSearchConfirm">搜索</text>
  </view>

  <!-- 轮播图 -->
  <swiper wx:if="{{banners.length}}" class="banner" indicator-dots autoplay circular interval="3500"
          indicator-active-color="#ff5a1f">
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <image class="banner-img" src="{{item.img}}" mode="aspectFill" />
    </swiper-item>
  </swiper>

  <!-- 公告栏 -->
  <view wx:if="{{noticeList.length}}" class="notice" bindtap="goNotices">
    <text class="notice-horn">📢</text>
    <view class="notice-body">
      <text class="notice-text ellipsis">{{noticeText}}</text>
    </view>
    <text class="notice-more">详情 ›</text>
  </view>

  <!-- 分类入口 -->
  <view wx:if="{{categories.length}}" class="cate-wrap">
    <view class="cate" wx:for="{{categories}}" wx:key="name" data-name="{{item.name}}" bindtap="goCategory">
      <view class="cate-icon">{{item.name}}</view>
    </view>
  </view>

  <!-- 商家列表 -->
  <view class="section-head">
    <text class="section-title">热门商家</text>
    <text class="section-more" bindtap="goProductPage">全部商品 ›</text>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中…</view>
  <view wx:elif="{{!businesses.length}}" class="empty">
    <text class="empty-icon">🏪</text>
    <text>暂无商家入驻</text>
  </view>

  <view wx:else>
    <view class="shop" wx:for="{{businesses}}" wx:key="id" data-id="{{item.id}}" bindtap="goBusiness">
      <image class="shop-logo" src="{{item.logoUrl}}" mode="aspectFill" wx:if="{{item.logoUrl}}" />
      <view class="shop-logo shop-logo-ph" wx:else>{{item.name[0]}}</view>

      <view class="shop-main">
        <view class="shop-name ellipsis">{{item.name}}</view>
        <view class="shop-meta">
          <text class="shop-score">★ {{item.scoreText}}</text>
          <text class="shop-dot">·</text>
          <text>月售 {{item.sales}}</text>
          <text class="shop-dot">·</text>
          <text>{{item.openText}}</text>
        </view>
        <view class="shop-tags">
          <text class="tag">起送 ¥{{item.minAmountText}}</text>
          <text class="tag tag-green" wx:if="{{item.freeDelivery}}">免配送费</text>
        </view>
        <view class="shop-addr ellipsis">{{item.address}}</view>
      </view>
    </view>
  </view>

  <view class="foot">— 已经到底啦 —</view>
</view>
