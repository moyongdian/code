<!-- 首页：极简科技风 -->
<view class="page">

  <!-- 顶部搜索区 -->
  <view class="topbar">
    <view class="brand">
      <view class="brand-mark">
        <van-icon name="fire-o" size="34rpx" color="#04121a" />
      </view>
      <view class="brand-text">
        <text class="brand-name">校园外卖</text>
        <text class="brand-sub">CAMPUS DELIVERY</text>
      </view>
    </view>
    <view class="search-wrap" bindtap="goProductPage">
      <van-icon name="search" size="30rpx" color="var(--text-3)" />
      <text class="search-ph">搜索商品 / 商家</text>
      <view class="search-key">
        <van-icon name="scan" size="26rpx" color="var(--accent)" />
      </view>
    </view>
  </view>

  <!-- 轮播图 -->
  <swiper wx:if="{{banners.length}}" class="banner" indicator-dots autoplay circular interval="4000"
          indicator-color="rgba(232,237,247,0.25)" indicator-active-color="#22d3ee">
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <image class="banner-img" src="{{item.img}}" mode="aspectFill" />
    </swiper-item>
  </swiper>

  <!-- 公告（Vant 滚动通告） -->
  <view wx:if="{{noticeList.length}}" class="notice-wrap">
    <van-notice-bar left-icon="volume-o" scrollable text="{{noticeText}}" bind:click="goNotices" />
  </view>

  <!-- 分类入口 -->
  <view wx:if="{{categories.length}}" class="block-title">分类精选</view>
  <view wx:if="{{categories.length}}" class="grid-wrap">
    <view class="cate" wx:for="{{categories}}" wx:key="name" data-name="{{item.name}}" bindtap="goCategory">
      <view class="cate-icon">
        <van-icon name="{{item.icon}}" size="40rpx" color="var(--accent)" />
      </view>
      <text class="cate-name">{{item.name}}</text>
    </view>
  </view>

  <!-- 商家列表 -->
  <view class="block-title">
    热门商家
    <text class="block-more" bindtap="goProductPage">全部商品 ›</text>
  </view>

  <!-- 加载骨架 -->
  <view wx:if="{{loading}}" class="section">
    <view class="sk-card" wx:for="{{[1,2]}}" wx:key="*this">
      <van-skeleton title row="2" />
    </view>
  </view>

  <!-- 空态 -->
  <van-empty wx:elif="{{!businesses.length}}" image="search" description="暂无商家入驻" />

  <!-- 商家卡片 -->
  <view wx:else class="section">
    <view class="shop" wx:for="{{businesses}}" wx:key="id" data-id="{{item.id}}" bindtap="goBusiness">
      <image class="shop-logo" src="{{item.logoUrl}}" mode="aspectFill" wx:if="{{item.logoUrl}}" />
      <view class="shop-logo shop-logo-ph" wx:else>
        <van-icon name="shop-o" size="48rpx" color="var(--accent)" />
      </view>

      <view class="shop-main">
        <view class="between">
          <text class="shop-name ellipsis">{{item.name}}</text>
          <view class="shop-open {{item.openStatus === 1 ? 'on' : ''}}">
            <view class="dot"></view>
            <text>{{item.openText}}</text>
          </view>
        </view>

        <view class="shop-meta">
          <view class="rate">
            <van-icon name="star" size="24rpx" color="var(--warn)" />
            <text class="rate-num">{{item.scoreText}}</text>
          </view>
          <text class="meta-sep">|</text>
          <text>月售 {{item.sales}}</text>
          <text class="meta-sep">|</text>
          <text class="mono">起送 ¥{{item.minAmountText}}</text>
        </view>

        <view class="shop-tags">
          <text class="tag tag-accent" wx:if="{{item.freeDelivery}}">免配送费</text>
          <text class="tag">{{item.openTime}} - {{item.closeTime}}</text>
        </view>

        <view class="shop-addr">
          <van-icon name="location-o" size="24rpx" color="var(--text-3)" />
          <text class="ellipsis">{{item.address}}</text>
        </view>
      </view>

      <van-icon name="arrow" size="26rpx" color="var(--text-3)" />
    </view>
  </view>

  <view class="foot" wx:if="{{!loading && businesses.length}}">
    <view class="foot-line"></view>
    <text>END OF LIST</text>
    <view class="foot-line"></view>
  </view>
</view>
