/* 我的评价 —— 极简科技风 */
.comment {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: var(--r-lg);
  padding: var(--sp-3);
  margin-bottom: var(--sp-3);
}
.comment-head { display: flex; align-items: center; justify-content: space-between; }
.comment-shop { display: flex; align-items: center; min-width: 0; }
.comment-shop text { margin: 0 8rpx; font-size: var(--fs-sm); font-weight: 600; color: var(--accent); max-width: 380rpx; }
.comment-time { font-size: var(--fs-xs); color: var(--text-3); flex-shrink: 0; }
.comment-stars { display: flex; margin-top: 14rpx; }
.comment-content { font-size: var(--fs-sm); color: var(--text-2); line-height: 1.6; margin-top: 14rpx; }
.comment-foot { display: flex; justify-content: flex-end; margin-top: var(--sp-2); }
.comment-del { display: flex; align-items: center; }
.comment-del text { font-size: var(--fs-xs); color: var(--text-3); margin-left: 6rpx; }
