/* 收货地址 —— 极简科技风 */
.mode-tip {
  display: flex; align-items: center;
  background: var(--accent-soft);
  padding: var(--sp-2) var(--sp-3);
}
.mode-tip text { margin-left: 8rpx; font-size: var(--fs-sm); color: var(--accent); }

.addr {
  display: flex; align-items: center;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: var(--r-lg);
  padding: var(--sp-3);
  margin-bottom: var(--sp-3);
}
.addr-icon {
  width: 72rpx; height: 72rpx; border-radius: var(--r-md);
  background: var(--accent-soft);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; margin-right: var(--sp-3);
}
.addr-main { min-width: 0; }
.addr-top { display: flex; align-items: baseline; }
.addr-name { font-size: var(--fs-md); font-weight: 700; margin-right: var(--sp-2); }
.addr-phone { font-size: var(--fs-sm); color: var(--accent-2); }
.addr-detail { font-size: var(--fs-sm); color: var(--text-3); margin-top: 10rpx; line-height: 1.5; }
.addr-op { display: flex; align-items: center; flex-shrink: 0; }
.op { padding: 12rpx; }
.add-text { margin-left: 10rpx; }
