/* 注册 —— 极简科技风 */
.req { color: var(--danger); }
.tip { padding: 0 var(--sp-3); }
.tip-line { display: flex; align-items: center; margin-top: var(--sp-2); }
.tip-line text { margin-left: 8rpx; font-size: var(--fs-xs); color: var(--text-3); }
.actions { padding: var(--sp-4) var(--sp-3); }
.link-row { text-align: center; margin-top: var(--sp-3); }
.link { font-size: var(--fs-sm); color: var(--accent); }
