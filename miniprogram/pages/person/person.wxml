<view class="page">
  <view class="card">
    <view class="avatar-row" bindtap="chooseAvatar">
      <text class="field-label">头像</text>
      <image class="avatar" src="{{avatarUrl}}" mode="aspectFill" wx:if="{{avatarUrl}}" />
      <view class="avatar avatar-ph" wx:else>+</view>
      <text class="avatar-arrow">›</text>
    </view>

    <view class="field">
      <text class="field-label">账号</text>
      <input class="field-input readonly" value="{{form.username}}" disabled />
    </view>
    <view class="field">
      <text class="field-label">姓名</text>
      <input class="field-input" placeholder="请输入姓名" placeholder-class="field-input-placeholder"
             value="{{form.name}}" data-field="name" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="field-label">性别</text>
      <picker class="field-input" mode="selector" range="{{sexOptions}}" value="{{form.sex}}"
              bindchange="onSexChange">
        <view class="picker-value">{{sexOptions[form.sex]}}</view>
      </picker>
    </view>
    <view class="field">
      <text class="field-label">联系电话</text>
      <input class="field-input" type="number" maxlength="11" placeholder="11 位手机号"
             placeholder-class="field-input-placeholder"
             value="{{form.phone}}" data-field="phone" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="field-label">邮箱</text>
      <input class="field-input" placeholder="选填" placeholder-class="field-input-placeholder"
             value="{{form.email}}" data-field="email" bindinput="onInput" />
    </view>
  </view>

  <view class="tip">账号不可修改。如需变更密码，请使用「修改密码」功能。</view>

  <view class="actions">
    <button class="btn-primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">
      {{submitting ? '保存中…' : '保存'}}
    </button>
  </view>
</view>
