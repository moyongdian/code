<!-- 购物车：极简科技风 -->
<view class="page">

  <!-- 未登录 / 空车 -->
  <block wx:if="{{!loading && !groups.length}}">
    <van-empty image="cart" description="购物车还是空的" />
    <view class="empty-action">
      <view class="btn btn-primary" bindtap="goHome">去逛逛</view>
    </view>
  </block>

  <view wx:elif="{{loading}}" class="loading">加载中…</view>

  <block wx:else>
    <!-- 概览条 -->
    <view class="overview">
      <view class="ov-item">
        <text class="ov-num mono">{{groups.length}}</text>
        <text class="ov-label">商家</text>
      </view>
      <view class="ov-line"></view>
      <view class="ov-item">
        <text class="ov-num mono">{{totalCount}}</text>
        <text class="ov-label">件商品</text>
      </view>
      <view class="ov-line"></view>
      <view class="ov-item">
        <text class="ov-num mono accent">¥{{totalAmount}}</text>
        <text class="ov-label">合计</text>
      </view>
    </view>

    <!-- 按商家分组 -->
    <view class="group" wx:for="{{groups}}" wx:key="bid" wx:for-item="g">
      <view class="group-head">
        <view class="group-shop" data-bid="{{g.bid}}" bindtap="checkout">
          <van-icon name="shop-o" size="30rpx" color="var(--accent)" />
          <text class="ellipsis">{{g.name}}</text>
          <van-icon name="arrow" size="22rpx" color="var(--text-3)" />
        </view>
        <view class="group-clear" data-bid="{{g.bid}}" catchtap="clearGroup">
          <van-icon name="delete-o" size="28rpx" color="var(--text-3)" />
        </view>
      </view>

      <view class="item" wx:for="{{g.items}}" wx:key="id" wx:for-item="it">
        <image class="item-img" src="{{it.imgUrl}}" mode="aspectFill" wx:if="{{it.imgUrl}}" />
        <view class="item-img item-img-ph" wx:else>
          <van-icon name="photo-o" size="40rpx" color="var(--text-3)" />
        </view>

        <view class="item-main flex-1">
          <view class="item-name ellipsis">{{it.name}}</view>
          <view class="item-price">
            <text class="price">¥{{it.realPriceText}}</text>
            <text class="price-origin" wx:if="{{it.hasDiscount}}">¥{{it.priceText}}</text>
          </view>
          <view class="item-line mono">小计 ¥{{it.lineTotal}}</view>
        </view>

        <view class="item-op">
          <view class="stepper">
            <view class="step-btn" data-id="{{it.id}}" data-pid="{{it.pid}}" data-delta="-1" bindtap="changeNum">
              <van-icon name="minus" size="24rpx" color="var(--accent)" />
            </view>
            <view class="step-num mono">{{it.num}}</view>
            <view class="step-btn" data-id="{{it.id}}" data-pid="{{it.pid}}" data-delta="1" bindtap="changeNum">
              <van-icon name="plus" size="24rpx" color="var(--accent)" />
            </view>
          </view>
          <view class="item-del" data-id="{{it.id}}" bindtap="removeItem">
            <van-icon name="delete-o" size="30rpx" color="var(--text-3)" />
          </view>
        </view>
      </view>

      <view class="group-foot">
        <text class="group-sum">共 <text class="mono">{{g.count}}</text> 件 ·
          合计 <text class="price">¥{{g.amountText}}</text></text>
        <view class="group-btn" data-bid="{{g.bid}}" bindtap="checkout">去结算</view>
      </view>
    </view>

    <view style="height:140rpx"></view>
    <view class="dock summary">
      <view class="sum-left">
        <text class="sum-label">合计</text>
        <text class="sum-amount mono">¥{{totalAmount}}</text>
      </view>
      <view class="sum-right">
        <text class="sum-count">{{totalCount}} 件</text>
      </view>
    </view>
  </block>
</view>
