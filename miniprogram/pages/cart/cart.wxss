/* 购物车 —— 极简科技风 */
.empty-action { padding: 0 120rpx; }

/* 概览条 */
.overview {
  display: flex; align-items: center; justify-content: space-around;
  margin: var(--sp-3);
  padding: var(--sp-3) 0;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: var(--r-lg);
}
.ov-item { display: flex; flex-direction: column; align-items: center; flex: 1; }
.ov-num { font-size: var(--fs-lg); font-weight: 700; }
.ov-num.accent { color: var(--accent); }
.ov-label { font-size: var(--fs-xs); color: var(--text-3); margin-top: 6rpx; }
.ov-line { width: 1rpx; height: 48rpx; background: var(--border); }

/* 分组卡片 */
.group {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: var(--r-lg);
  margin: 0 var(--sp-3) var(--sp-3);
  overflow: hidden;
}
.group-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: var(--sp-3) var(--sp-3) var(--sp-2);
  border-bottom: 1rpx solid var(--border);
}
.group-shop { display: flex; align-items: center; flex: 1; min-width: 0; }
.group-shop text {
  margin: 0 8rpx; font-size: var(--fs-md); font-weight: 600;
  max-width: 420rpx;
}
.group-clear { padding: 8rpx; }

/* 商品行 */
.item { display: flex; padding: var(--sp-3); border-bottom: 1rpx solid var(--border); }
.item-img { width: 132rpx; height: 132rpx; border-radius: var(--r-md); background: var(--surface-2); flex-shrink: 0; }
.item-img-ph { display: flex; align-items: center; justify-content: center; }
.item-main { margin-left: var(--sp-2); min-width: 0; }
.item-name { font-size: var(--fs-md); font-weight: 600; }
.item-price { display: flex; align-items: baseline; margin-top: 10rpx; }
.item-price .price { font-size: var(--fs-md); }
.item-line { font-size: var(--fs-xs); color: var(--text-3); margin-top: 8rpx; }

.item-op { display: flex; flex-direction: column; align-items: flex-end; justify-content: space-between; }
.stepper { display: flex; align-items: center; }
.step-btn {
  width: 52rpx; height: 52rpx; border-radius: 50%;
  border: 1rpx solid var(--border-strong);
  display: flex; align-items: center; justify-content: center;
}
.step-num { min-width: 60rpx; text-align: center; font-size: var(--fs-md); font-weight: 600; }
.item-del { padding: 16rpx 0 0 16rpx; }

/* 分组结算 */
.group-foot {
  display: flex; align-items: center; justify-content: space-between;
  padding: var(--sp-3);
  background: var(--bg-elev);
}
.group-sum { font-size: var(--fs-sm); color: var(--text-2); }
.group-sum .price { font-size: var(--fs-md); }
.group-btn {
  background: var(--grad-accent); color: #04121a;
  font-size: var(--fs-sm); font-weight: 700;
  height: 68rpx; line-height: 68rpx; padding: 0 40rpx;
  border-radius: var(--r-pill);
}

/* 底部合计 */
.summary { display: flex; align-items: center; justify-content: space-between; }
.sum-left { display: flex; align-items: baseline; }
.sum-label { font-size: var(--fs-sm); color: var(--text-2); margin-right: 12rpx; }
.sum-amount { font-size: var(--fs-2xl); font-weight: 700; color: var(--accent); }
.sum-count { font-size: var(--fs-sm); color: var(--text-3); }
