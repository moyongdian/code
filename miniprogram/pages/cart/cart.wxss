.empty-actions {
  padding: 0 120rpx;
}

.group {
  background: #fff;
  margin: 20rpx 24rpx 0;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(24, 33, 56, 0.04);
}

.group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx 16rpx;
}

.group-shop {
  font-size: 29rpx;
  font-weight: 700;
}

.group-clear {
  font-size: 24rpx;
  color: #a3a9b5;
}

.item {
  display: flex;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #f7f8fa;
}

.item-img {
  width: 130rpx;
  height: 130rpx;
  border-radius: 14rpx;
  background: #f2f3f5;
  flex-shrink: 0;
}

.item-img-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
}

.item-main {
  flex: 1;
  margin-left: 18rpx;
  overflow: hidden;
}

.item-name {
  font-size: 28rpx;
  font-weight: 600;
}

.item-price {
  margin-top: 10rpx;
  display: flex;
  align-items: baseline;
}

.item-price .price {
  font-size: 30rpx;
  margin-right: 10rpx;
}

.item-line {
  font-size: 22rpx;
  color: #a3a9b5;
  margin-top: 8rpx;
}

.item-op {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: space-between;
}

.stepper {
  display: flex;
  align-items: center;
}

.step-btn {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  border: 2rpx solid #e6e8ee;
  color: #4a5163;
  font-size: 30rpx;
  line-height: 46rpx;
  text-align: center;
}

.step-num {
  min-width: 56rpx;
  text-align: center;
  font-size: 27rpx;
  font-weight: 600;
}

.item-del {
  font-size: 23rpx;
  color: #b8bdc8;
  margin-top: 16rpx;
}

.group-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #fbfbfc;
}

.group-sum {
  font-size: 25rpx;
  color: #6b7280;
}

.group-sum .price {
  font-size: 30rpx;
}

.group-btn {
  background: linear-gradient(135deg, #ff8a4c, #ff5a1f);
  color: #fff;
  font-size: 27rpx;
  font-weight: 700;
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 40rpx;
  border-radius: 999rpx;
}

.summary-bar {
  margin: 24rpx 24rpx 0;
  background: #2b3040;
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
}

.summary-text {
  color: #fff;
  font-size: 28rpx;
}

.summary-text .price {
  font-size: 36rpx;
}
