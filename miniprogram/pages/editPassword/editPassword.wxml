<!-- 修改密码：极简科技风 -->
<view class="page">
  <view class="card">
    <view class="field">
      <text class="field-label">旧密码</text>
      <input class="field-input" password placeholder="当前密码" placeholder-class="field-ph"
             value="{{oldPassword}}" data-field="oldPassword" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="field-label">新密码</text>
      <input class="field-input" password placeholder="6-20 位" placeholder-class="field-ph"
             value="{{newPassword}}" data-field="newPassword" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="field-label">确认密码</text>
      <input class="field-input" password placeholder="再次输入新密码" placeholder-class="field-ph"
             value="{{confirm}}" data-field="confirm" bindinput="onInput" />
    </view>
  </view>

  <view class="tip">
    <view class="tip-line"><van-icon name="shield-o" size="26rpx" color="var(--accent)" /><text>需先校验旧密码，确认是本人操作</text></view>
    <view class="tip-line"><van-icon name="info-o" size="26rpx" color="var(--warn)" /><text>修改成功后当前登录状态失效，需重新登录</text></view>
  </view>

  <view class="actions">
    <view class="btn btn-primary {{submitting ? 'disabled' : ''}}" bindtap="submit">
      {{submitting ? '提交中…' : '确认修改'}}
    </view>
  </view>
</view>
