.empty-actions {
  padding: 0 120rpx;
}

.tabs {
  display: flex;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 5;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #6b7280;
  position: relative;
}

.tab.active {
  color: #ff5a1f;
  font-weight: 700;
}

.tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 48rpx;
  height: 5rpx;
  border-radius: 3rpx;
  background: #ff5a1f;
}

.order {
  background: #fff;
  margin: 20rpx 24rpx 0;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(24, 33, 56, 0.04);
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid #f7f8fa;
}

.order-no {
  font-size: 23rpx;
  color: #8c94a3;
}

.order-status {
  font-size: 26rpx;
  font-weight: 700;
}

.order-body {
  display: flex;
  align-items: center;
  padding: 24rpx;
}

.order-cover {
  width: 116rpx;
  height: 116rpx;
  border-radius: 14rpx;
  background: #f2f3f5;
  flex-shrink: 0;
}

.order-cover-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
}

.order-main {
  flex: 1;
  margin-left: 18rpx;
  overflow: hidden;
}

.order-name {
  font-size: 28rpx;
  font-weight: 600;
}

.order-time {
  font-size: 22rpx;
  color: #a3a9b5;
  margin-top: 10rpx;
}

.order-delivery {
  font-size: 22rpx;
  color: #2f80ed;
  margin-top: 8rpx;
}

.order-price {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.order-price .price {
  font-size: 32rpx;
}

.order-origin {
  font-size: 22rpx;
  color: #b8bdc8;
  text-decoration: line-through;
  margin-top: 6rpx;
}

.order-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #fbfbfc;
}

.foot-contact {
  font-size: 25rpx;
  color: #2f80ed;
}

.foot-actions {
  display: flex;
  align-items: center;
  margin-left: auto;
}

.foot-actions > view {
  margin-left: 16rpx;
}

.btn-primary.sm {
  line-height: 64rpx;
  height: 64rpx;
  padding: 0 32rpx;
  font-size: 26rpx;
}
