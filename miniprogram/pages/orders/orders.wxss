/* 我的订单 —— 极简科技风 */
.empty-action { padding: 0 120rpx; }

/* 状态标签 */
.tabs { display: flex; background: var(--surface); border-bottom: 1rpx solid var(--border); }
.tab {
  flex: 1; text-align: center; padding: var(--sp-3) 0;
  font-size: var(--fs-sm); color: var(--text-3); position: relative;
}
.tab.active { color: var(--accent); font-weight: 600; }
.tab-bar {
  position: absolute; left: 50%; bottom: 0;
  transform: translateX(-50%);
  width: 48rpx; height: 5rpx; border-radius: 3rpx;
  background: transparent;
}
.tab.active .tab-bar { background: var(--grad-accent); }

/* 订单卡片 */
.order {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: var(--r-lg);
  overflow: hidden;
  margin-bottom: var(--sp-3);
}
.order-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: var(--sp-2) var(--sp-3);
  border-bottom: 1rpx solid var(--border);
}
.order-no { font-size: var(--fs-xs); color: var(--text-3); }
.order-status { font-size: var(--fs-sm); font-weight: 700; }

.order-body { display: flex; align-items: center; padding: var(--sp-3); }
.order-cover { width: 120rpx; height: 120rpx; border-radius: var(--r-md); background: var(--surface-2); flex-shrink: 0; }
.order-cover-ph { display: flex; align-items: center; justify-content: center; }
.order-main { margin: 0 var(--sp-2); min-width: 0; }
.order-name { font-size: var(--fs-md); font-weight: 600; }
.order-time { font-size: var(--fs-xs); color: var(--text-3); margin-top: 10rpx; }
.order-delivery { display: flex; align-items: center; margin-top: 8rpx; }
.order-delivery text { font-size: var(--fs-xs); color: var(--accent-2); margin-left: 6rpx; }

.order-price { display: flex; flex-direction: column; align-items: flex-end; }
.order-price .price { font-size: var(--fs-lg); }
.order-origin { font-size: var(--fs-xs); color: var(--text-3); text-decoration: line-through; margin-top: 6rpx; }

.order-foot {
  display: flex; align-items: center; justify-content: space-between;
  padding: var(--sp-2) var(--sp-3);
  background: var(--bg-elev);
}
.foot-contact { display: flex; align-items: center; }
.foot-contact text { font-size: var(--fs-sm); color: var(--accent-2); margin-left: 6rpx; }
.foot-actions { display: flex; align-items: center; margin-left: auto; }

.a-btn {
  height: 60rpx; padding: 0 28rpx; margin-left: 14rpx;
  border-radius: var(--r-pill);
  font-size: var(--fs-sm); font-weight: 600;
  display: flex; align-items: center; justify-content: center;
}
.a-btn.ghost { border: 1rpx solid var(--border-strong); color: var(--text-2); }
.a-btn.accent { border: 1rpx solid rgba(34,211,238,0.35); color: var(--accent); }
.a-btn.primary { background: var(--grad-accent); color: #04121a; }
