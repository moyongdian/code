/* 确认订单 —— 极简科技风 */
.card-title { font-size: var(--fs-md); font-weight: 600; margin-bottom: var(--sp-2); }

/* 地址 */
.addr-card { display: flex; align-items: center; }
.addr-icon {
  width: 72rpx; height: 72rpx; border-radius: var(--r-md);
  background: var(--accent-soft);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; margin-right: var(--sp-3);
}
.addr-user { display: flex; align-items: baseline; }
.addr-name { font-size: var(--fs-md); font-weight: 700; margin-right: var(--sp-2); }
.addr-phone { font-size: var(--fs-sm); color: var(--text-2); }
.addr-detail { font-size: var(--fs-sm); color: var(--text-3); margin-top: 10rpx; line-height: 1.5; }
.addr-empty { font-size: var(--fs-md); color: var(--accent); }

/* 商品清单 */
.biz-name { display: flex; align-items: center; }
.biz-name text { margin-left: 10rpx; font-size: var(--fs-md); font-weight: 600; }
.item { display: flex; align-items: center; padding: var(--sp-2) 0; }
.item-img { width: 100rpx; height: 100rpx; border-radius: var(--r-sm); background: var(--surface-2); flex-shrink: 0; }
.item-img-ph { display: flex; align-items: center; justify-content: center; }
.item-main { margin-left: var(--sp-2); min-width: 0; }
.item-name { font-size: var(--fs-sm); font-weight: 600; }
.item-qty { font-size: var(--fs-xs); color: var(--text-3); margin-top: 8rpx; }
.item-price { display: flex; flex-direction: column; align-items: flex-end; }
.item-price .price { font-size: var(--fs-sm); }

/* 费用 */
.fee-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 12rpx 0; font-size: var(--fs-sm); color: var(--text-2);
}
.fee-cut { color: var(--accent); }
.fee-free { color: var(--success); }
.fee-row.total { font-size: var(--fs-md); font-weight: 700; color: var(--text); }
.fee-row.total .price { font-size: var(--fs-xl); }

/* 支付方式 */
.pay-row { display: flex; align-items: center; padding: var(--sp-2) 0; }
.pay-row + .pay-row { border-top: 1rpx solid var(--border); }
.pay-name { margin-left: var(--sp-2); font-size: var(--fs-md); }
.pay-check {
  width: 40rpx; height: 40rpx; border-radius: 50%;
  border: 2rpx solid var(--border-strong);
  display: flex; align-items: center; justify-content: center;
}
.pay-check.on { background: var(--accent); border-color: var(--accent); }

/* 备注 */
.remark {
  width: 100%; height: 130rpx;
  font-size: var(--fs-sm); line-height: 1.6; color: var(--text);
}
.remark-ph { color: var(--text-3); }

/* 提交栏 */
.submit-bar { display: flex; align-items: center; justify-content: space-between; }
.submit-left { display: flex; align-items: baseline; }
.submit-label { font-size: var(--fs-sm); color: var(--text-2); margin-right: 12rpx; }
.submit-amount { font-size: var(--fs-2xl); font-weight: 700; color: var(--accent); }
.submit-btn {
  background: var(--grad-accent); color: #04121a;
  font-size: var(--fs-md); font-weight: 700;
  height: 84rpx; line-height: 84rpx; padding: 0 56rpx;
  border-radius: var(--r-pill);
  box-shadow: 0 6rpx 20rpx var(--accent-glow);
}
.submit-btn.disabled { background: var(--surface-3); color: var(--text-3); box-shadow: none; }
