<view class="page confirm-page">
  <view wx:if="{{loading}}" class="loading">加载中…</view>

  <block wx:else>
    <!-- 收货地址 -->
    <view class="card addr-card" bindtap="goAddress">
      <block wx:if="{{address}}">
        <view class="addr-left">
          <view class="addr-user">
            <text class="addr-name">{{address.user}}</text>
            <text class="addr-phone">{{address.phone}}</text>
          </view>
          <view class="addr-detail">{{address.address}}</view>
        </view>
        <text class="addr-arrow">›</text>
      </block>
      <block wx:else>
        <view class="addr-empty">📍 请添加收货地址</view>
        <text class="addr-arrow">›</text>
      </block>
    </view>

    <!-- 商品清单 -->
    <view class="card">
      <view class="biz-name">🏪 {{business.name}}</view>
      <view class="divider"></view>
      <view class="item" wx:for="{{items}}" wx:key="id">
        <image class="item-img" src="{{item.imgUrl}}" mode="aspectFill" wx:if="{{item.imgUrl}}" />
        <view class="item-img item-img-ph" wx:else>🍲</view>
        <view class="item-main">
          <view class="item-name ellipsis">{{item.name}}</view>
          <view class="item-qty">×{{item.num}}</view>
        </view>
        <view class="item-price">
          <text class="price">¥{{item.realPriceText}}</text>
          <text class="price-origin">¥{{item.priceText}}</text>
        </view>
      </view>
    </view>

    <!-- 费用明细 -->
    <view class="card">
      <view class="fee-row">
        <text>商品原价</text>
        <text>¥{{amount}}</text>
      </view>
      <view class="fee-row">
        <text>7 折活动优惠</text>
        <text class="fee-cut">-¥{{discount}}</text>
      </view>
      <view class="fee-row">
        <text>打包费</text>
        <text>¥{{packFee}}</text>
      </view>
      <view class="fee-row">
        <text>配送费</text>
        <text class="fee-free">免费</text>
      </view>
      <view class="divider"></view>
      <view class="fee-row total">
        <text>合计</text>
        <text class="price">¥{{actual}}</text>
      </view>
    </view>

    <!-- 支付方式 -->
    <view class="card">
      <view class="card-title">支付方式</view>
      <view class="pay-row" wx:for="{{payTypes}}" wx:key="*this"
            data-type="{{item}}" bindtap="choosePayType">
        <text class="pay-name">{{item === '微信' ? '💚 微信支付' : '💙 支付宝'}}</text>
        <text class="pay-check {{payType === item ? 'on' : ''}}">{{payType === item ? '✓' : ''}}</text>
      </view>
    </view>

    <!-- 备注 -->
    <view class="card">
      <view class="card-title">订单备注</view>
      <textarea class="remark" placeholder="口味、餐具份数等要求（选填）" placeholder-class="remark-ph"
                maxlength="100" value="{{remark}}" bindinput="onRemarkInput" />
    </view>

    <!-- 提交栏 -->
    <view class="submit-bar safe-bottom">
      <view class="submit-left">
        <text class="submit-label">合计</text>
        <text class="submit-amount">¥{{actual}}</text>
      </view>
      <view class="submit-btn {{submitting ? 'disabled' : ''}}" bindtap="submit">
        {{submitting ? '提交中…' : '提交订单'}}
      </view>
    </view>
    <view style="height:140rpx"></view>
  </block>
</view>
