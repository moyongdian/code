<view class="page">
  <view class="card">
    <view class="field">
      <text class="field-label">用户名</text>
      <input class="field-input" placeholder="请输入注册时的用户名" placeholder-class="field-input-placeholder"
             value="{{username}}" data-field="username" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="field-label">手机号</text>
      <input class="field-input" type="number" maxlength="11" placeholder="请输入注册时填写的手机号"
             placeholder-class="field-input-placeholder"
             value="{{phone}}" data-field="phone" bindinput="onInput" />
    </view>
  </view>

  <view class="tip">
    · 需用户名与手机号同时匹配才能重置
    · 重置后的密码固定为 <text class="hl">123</text>，请登录后及时修改
  </view>

  <view class="actions">
    <button class="btn-primary" loading="{{loading}}" disabled="{{loading}}" bindtap="onSubmit">
      {{loading ? '提交中…' : '重置密码'}}
    </button>
  </view>
</view>
