<!-- 忘记密码：极简科技风 -->
<view class="page">
  <view class="card">
    <view class="field">
      <text class="field-label">用户名</text>
      <input class="field-input" placeholder="注册时的用户名" placeholder-class="field-ph"
             value="{{username}}" data-field="username" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="field-label">手机号</text>
      <input class="field-input mono" type="number" maxlength="11" placeholder="注册时填写的手机号"
             placeholder-class="field-ph"
             value="{{phone}}" data-field="phone" bindinput="onInput" />
    </view>
  </view>

  <view class="tip">
    <view class="tip-line"><van-icon name="shield-o" size="26rpx" color="var(--accent)" /><text>需用户名与手机号同时匹配才能重置</text></view>
    <view class="tip-line"><van-icon name="warning-o" size="26rpx" color="var(--warn)" /><text>重置后密码固定为 123，请登录后及时修改</text></view>
  </view>

  <view class="actions">
    <view class="btn btn-primary {{loading ? 'disabled' : ''}}" bindtap="onSubmit">
      {{loading ? '提交中…' : '重置密码'}}
    </view>
  </view>
</view>
