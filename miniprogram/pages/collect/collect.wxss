/* 我的收藏 —— 极简科技风 */
.shop {
  display: flex; align-items: center;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: var(--r-lg);
  padding: var(--sp-3);
  margin-bottom: var(--sp-3);
}
.shop-logo { width: 128rpx; height: 128rpx; border-radius: var(--r-md); background: var(--surface-2); flex-shrink: 0; }
.shop-logo-ph { display: flex; align-items: center; justify-content: center; }
.shop-main { margin: 0 var(--sp-2); min-width: 0; }
.shop-name { font-size: var(--fs-md); font-weight: 700; }
.shop-meta { display: flex; align-items: center; margin-top: 10rpx; font-size: var(--fs-xs); color: var(--text-3); }
.shop-meta .score { margin-left: 6rpx; color: var(--warn); font-weight: 600; }
.shop-meta .sep { margin: 0 10rpx; opacity: 0.4; }
.shop-addr { font-size: var(--fs-xs); color: var(--text-3); margin-top: 10rpx; }
.cancel { padding: 12rpx 0 12rpx 16rpx; flex-shrink: 0; }
