/* 商家详情 —— 极简科技风 */
.detail-page { display: flex; flex-direction: column; height: 100vh; }

/* ---------- 头部 ---------- */
.head {
  position: relative;
  background: var(--surface);
  border-bottom: 1rpx solid var(--border);
  padding: var(--sp-3) var(--sp-3) var(--sp-3);
  overflow: hidden;
}
.head-glow {
  position: absolute; top: -180rpx; right: -140rpx;
  width: 400rpx; height: 400rpx; border-radius: 50%;
  background: radial-gradient(circle, rgba(34,211,238,0.18), transparent 65%);
}
.head-top { position: relative; display: flex; align-items: flex-start; }

.head-logo {
  width: 132rpx; height: 132rpx;
  border-radius: var(--r-md);
  background: var(--surface-2);
  border: 1rpx solid var(--border);
  flex-shrink: 0;
}
.head-logo-ph { display: flex; align-items: center; justify-content: center; }

.head-info { margin: 0 var(--sp-2); min-width: 0; }
.head-name { font-size: var(--fs-lg); font-weight: 700; }
.head-meta {
  display: flex; align-items: center;
  margin-top: 10rpx; font-size: var(--fs-xs); color: var(--text-3);
}
.head-score { margin-left: 6rpx; color: var(--warn); font-weight: 600; }
.head-meta .sep { margin: 0 12rpx; opacity: 0.4; }
.head-tags { margin-top: 12rpx; }
.head-tags .tag { margin-right: 8rpx; }

.collect { width: 104rpx; text-align: center; flex-shrink: 0; }
.collect-text { display: block; font-size: var(--fs-xs); color: var(--text-3); margin-top: 4rpx; }
.collect-text.on { color: var(--warn); }

.head-addr {
  display: flex; align-items: center;
  margin-top: var(--sp-3);
  font-size: var(--fs-sm); color: var(--text-3);
}
.head-addr text { margin-left: 8rpx; }
.head-phone {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: var(--accent-soft);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; margin-left: var(--sp-2);
}
.head-intro {
  margin-top: 12rpx; font-size: var(--fs-sm);
  color: var(--text-3); line-height: 1.5;
}

/* ---------- 选项卡 ---------- */
.tabs {
  display: flex; background: var(--surface);
  border-bottom: 1rpx solid var(--border);
  flex-shrink: 0;
}
.tab {
  flex: 1; text-align: center; padding: var(--sp-3) 0;
  font-size: var(--fs-md); color: var(--text-3); position: relative;
}
.tab.active { color: var(--accent); font-weight: 600; }
.tab.active::after {
  content: ''; position: absolute; left: 50%; bottom: 0;
  transform: translateX(-50%);
  width: 56rpx; height: 5rpx; border-radius: 3rpx;
  background: var(--grad-accent);
}
.tab-num { font-size: var(--fs-xs); opacity: 0.7; }

/* ---------- 商品区 ---------- */
.goods { flex: 1; display: flex; overflow: hidden; }

.cate-nav {
  width: 186rpx; height: 100%;
  background: var(--bg-elev);
  border-right: 1rpx solid var(--border);
  flex-shrink: 0;
}
.cate-item {
  display: flex; align-items: center;
  padding: 30rpx var(--sp-2);
  font-size: var(--fs-sm); color: var(--text-2);
}
.cate-bar {
  width: 6rpx; height: 28rpx; border-radius: 3rpx;
  background: transparent; margin-right: 12rpx; flex-shrink: 0;
}
.cate-item.active {
  background: var(--surface); color: var(--accent); font-weight: 600;
}
.cate-item.active .cate-bar { background: var(--grad-accent); }
.cate-empty { padding: 40rpx 0; text-align: center; color: var(--text-3); font-size: var(--fs-xs); }

.prod-list { flex: 1; background: var(--surface); height: 100%; }

.prod {
  display: flex; padding: var(--sp-3);
  border-bottom: 1rpx solid var(--border);
}
.prod-img {
  width: 150rpx; height: 150rpx;
  border-radius: var(--r-md); background: var(--surface-2);
  flex-shrink: 0;
}
.prod-img-ph { display: flex; align-items: center; justify-content: center; }

.prod-main { margin-left: var(--sp-2); display: flex; flex-direction: column; min-width: 0; }
.prod-name { font-size: var(--fs-md); font-weight: 600; }
.prod-desc { font-size: var(--fs-xs); color: var(--text-3); margin-top: 8rpx; }
.prod-sale { font-size: var(--fs-xs); color: var(--text-3); margin-top: 8rpx; }
.prod-bottom { margin-top: auto; display: flex; align-items: center; justify-content: space-between; }
.prod-price { display: flex; align-items: baseline; }
.prod-price .price { font-size: var(--fs-lg); }

.prod-op { display: flex; align-items: center; }
.prod-num { font-size: var(--fs-xs); color: var(--text-3); margin-right: 12rpx; }
.add-btn {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: var(--grad-accent);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4rpx 14rpx var(--accent-glow);
}

/* ---------- 评价 ---------- */
.comments { flex: 1; overflow-y: auto; background: var(--surface); }
.comment { padding: var(--sp-3); border-bottom: 1rpx solid var(--border); }
.comment-top { display: flex; align-items: center; }
.comment-avatar {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: var(--accent-soft); color: var(--accent);
  font-size: var(--fs-md); font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; margin-right: var(--sp-2);
}
.comment-name { font-size: var(--fs-sm); font-weight: 600; }
.comment-stars { display: flex; margin-top: 6rpx; }
.comment-time { font-size: var(--fs-xs); color: var(--text-3); flex-shrink: 0; }
.comment-content {
  margin-top: var(--sp-2); font-size: var(--fs-sm);
  color: var(--text-2); line-height: 1.6;
}

/* ---------- 底部购物车栏 ---------- */
.cart-bar { display: flex; align-items: center; }
.cart-left { flex: 1; display: flex; align-items: center; }
.cart-icon { position: relative; }
.cart-amount { margin-left: var(--sp-3); }
.cart-total { font-size: var(--fs-xl); font-weight: 700; color: var(--accent); }
.cart-empty { font-size: var(--fs-sm); color: var(--text-3); }
.cart-submit {
  background: var(--grad-accent); color: #04121a;
  font-size: var(--fs-md); font-weight: 700;
  height: 80rpx; line-height: 80rpx; padding: 0 48rpx;
  border-radius: var(--r-pill);
  box-shadow: 0 6rpx 20rpx var(--accent-glow);
}
.cart-submit.disabled { background: var(--surface-3); color: var(--text-3); box-shadow: none; }

/* ---------- 购物车弹层 ---------- */
.cart-panel {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: var(--bg-elev);
  border-top: 1rpx solid var(--border);
  border-radius: var(--r-xl) var(--r-xl) 0 0;
  z-index: var(--z-panel);
  max-height: 66vh;
  display: flex; flex-direction: column;
}
.cart-panel-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: var(--sp-3);
  border-bottom: 1rpx solid var(--border);
}
.cart-panel-title { font-size: var(--fs-md); font-weight: 600; }
.cart-panel-clear { display: flex; align-items: center; }
.cart-panel-clear text { font-size: var(--fs-sm); color: var(--text-3); margin-left: 6rpx; }
.cart-panel-list { max-height: 46vh; padding: 0 var(--sp-3); }

.cart-row {
  display: flex; align-items: center;
  padding: var(--sp-2) 0;
  border-bottom: 1rpx solid var(--border);
}
.cart-row-img {
  width: 96rpx; height: 96rpx; border-radius: var(--r-sm);
  background: var(--surface-2); flex-shrink: 0;
}
.cart-row-img-ph { display: flex; align-items: center; justify-content: center; }
.cart-row-main { margin-left: var(--sp-2); min-width: 0; }
.cart-row-name { font-size: var(--fs-sm); font-weight: 600; }
.cart-row-price { font-size: var(--fs-sm); color: var(--accent); font-weight: 600; margin-top: 8rpx; }

.stepper { display: flex; align-items: center; }
.step-btn {
  width: 52rpx; height: 52rpx; border-radius: 50%;
  border: 1rpx solid var(--border-strong);
  display: flex; align-items: center; justify-content: center;
}
.step-num { min-width: 64rpx; text-align: center; font-size: var(--fs-md); font-weight: 600; }

.cart-panel-foot {
  display: flex; align-items: center; justify-content: space-between;
  padding: var(--sp-3);
  border-top: 1rpx solid var(--border);
}
.cart-panel-total { font-size: var(--fs-sm); color: var(--text-2); }
.cart-panel-total .price { font-size: var(--fs-lg); }
.cart-panel-btn {
  background: var(--grad-accent); color: #04121a;
  font-size: var(--fs-sm); font-weight: 700;
  height: 72rpx; line-height: 72rpx; padding: 0 44rpx;
  border-radius: var(--r-pill);
}
