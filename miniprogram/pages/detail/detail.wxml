<!-- 商家详情：极简科技风 -->
<view class="page detail-page">

  <!-- 商家头部 -->
  <view class="head" wx:if="{{business}}">
    <view class="head-glow"></view>
    <view class="head-top">
      <image class="head-logo" src="{{business.logoUrl}}" mode="aspectFill" wx:if="{{business.logoUrl}}" />
      <view class="head-logo head-logo-ph" wx:else>
        <van-icon name="shop-o" size="52rpx" color="var(--accent)" />
      </view>

      <view class="head-info flex-1">
        <view class="head-name ellipsis">{{business.name}}</view>
        <view class="head-meta">
          <van-icon name="star" size="24rpx" color="var(--warn)" />
          <text class="head-score">{{business.scoreText}}</text>
          <text class="sep">|</text>
          <text>月售 {{business.sales}}</text>
        </view>
        <view class="head-tags">
          <text class="tag tag-accent">起送 ¥{{business.minAmountText}}</text>
          <text class="tag tag-success" wx:if="{{business.openStatus === 1}}">营业中</text>
          <text class="tag" wx:else>休息中</text>
        </view>
      </view>

      <view class="collect" bindtap="toggleCollect">
        <van-icon name="{{isCollect ? 'star' : 'star-o'}}" size="46rpx"
                  color="{{isCollect ? '#fbbf24' : '#63708a'}}" />
        <text class="collect-text {{isCollect ? 'on' : ''}}">{{isCollect ? '已收藏' : '收藏'}}</text>
      </view>
    </view>

    <view class="head-addr">
      <van-icon name="location-o" size="26rpx" color="var(--text-3)" />
      <text class="ellipsis flex-1">{{business.address}}</text>
      <view class="head-phone" catchtap="callShop">
        <van-icon name="phone-o" size="26rpx" color="var(--accent)" />
      </view>
    </view>
    <view class="head-intro ellipsis-2" wx:if="{{business.introduce}}">{{business.introduce}}</view>
  </view>

  <!-- 选项卡 -->
  <view class="tabs">
    <view class="tab {{tab === 'goods' ? 'active' : ''}}" data-tab="goods" bindtap="switchTab">全部商品</view>
    <view class="tab {{tab === 'comments' ? 'active' : ''}}" data-tab="comments" bindtap="switchTab">
      评价 <text class="tab-num">{{comments.length}}</text>
    </view>
  </view>

  <!-- 商品区 -->
  <view class="goods" wx:if="{{tab === 'goods'}}">
    <scroll-view class="cate-nav" scroll-y>
      <view wx:for="{{categories}}" wx:key="id"
            class="cate-item {{activeCid === item.id ? 'active' : ''}}"
            data-cid="{{item.id}}" bindtap="switchCategory">
        <view class="cate-bar"></view>
        <text>{{item.name}}</text>
      </view>
      <view wx:if="{{!categories.length}}" class="cate-empty">暂无分类</view>
    </scroll-view>

    <scroll-view class="prod-list" scroll-y>
      <view wx:if="{{loading}}" class="loading">加载中…</view>
      <van-empty wx:elif="{{!products.length}}" image="search" description="该分类暂无商品" />

      <view class="prod" wx:for="{{products}}" wx:key="id">
        <image class="prod-img" src="{{item.imgUrl}}" mode="aspectFill"
               data-url="{{item.imgUrl}}" bindtap="previewImage" wx:if="{{item.imgUrl}}" />
        <view class="prod-img prod-img-ph" wx:else>
          <van-icon name="photo-o" size="44rpx" color="var(--text-3)" />
        </view>

        <view class="prod-main flex-1">
          <view class="prod-name ellipsis">{{item.name}}</view>
          <view class="prod-desc ellipsis">{{item.description}}</view>
          <view class="prod-sale mono">已售 {{item.sum}}</view>
          <view class="prod-bottom">
            <view class="prod-price">
              <text class="price">¥{{item.realPriceText}}</text>
              <text class="price-origin" wx:if="{{item.hasDiscount}}">¥{{item.priceText}}</text>
            </view>
            <view class="prod-op">
              <text class="prod-num mono" wx:if="{{item.num > 0}}">×{{item.num}}</text>
              <view class="add-btn" data-item="{{item}}" catchtap="addToCart">
                <van-icon name="plus" size="30rpx" color="#04121a" />
              </view>
            </view>
          </view>
        </view>
      </view>
      <view style="height:160rpx"></view>
    </scroll-view>
  </view>

  <!-- 评价区 -->
  <view class="comments" wx:else>
    <van-empty wx:if="{{!comments.length}}" image="search" description="暂无评价" />
    <view class="comment" wx:for="{{comments}}" wx:key="id">
      <view class="comment-top">
        <view class="comment-avatar">{{item.userInitial}}</view>
        <view class="flex-1">
          <view class="comment-name">{{item.userName}}</view>
          <view class="comment-stars">
            <van-icon wx:for="{{item.starArr}}" wx:key="*this" name="star" size="22rpx"
                      color="{{item2 ? '#fbbf24' : '#2c3850'}}" wx:for-item="item2" />
          </view>
        </view>
        <text class="comment-time">{{item.time}}</text>
      </view>
      <view class="comment-content">{{item.content}}</view>
    </view>
  </view>

  <!-- 底部购物车栏 -->
  <view class="dock cart-bar">
    <view class="cart-left" bindtap="toggleCartPanel">
      <view class="cart-icon">
        <van-icon name="cart-o" size="48rpx" color="{{cartCount > 0 ? '#22d3ee' : '#63708a'}}" />
        <view class="badge" wx:if="{{cartCount > 0}}">{{cartCount}}</view>
      </view>
      <view class="cart-amount">
        <text class="cart-total mono" wx:if="{{cartCount > 0}}">¥{{cartTotal}}</text>
        <text class="cart-empty" wx:else>购物车是空的</text>
      </view>
    </view>
    <view class="cart-submit {{cartCount > 0 ? '' : 'disabled'}}" bindtap="goConfirm">立即下单</view>
  </view>

  <!-- 购物车弹层 -->
  <van-overlay show="{{showCart}}" bind:click="closeCartPanel" z-index="55" />
  <view class="cart-panel" wx:if="{{showCart}}">
    <view class="cart-panel-head">
      <text class="cart-panel-title">已选商品</text>
      <view class="cart-panel-clear" bindtap="clearCart">
        <van-icon name="delete-o" size="28rpx" color="var(--text-3)" />
        <text>清空</text>
      </view>
    </view>
    <scroll-view class="cart-panel-list" scroll-y>
      <view class="cart-row" wx:for="{{cartList}}" wx:key="id">
        <image class="cart-row-img" src="{{item.imgUrl}}" mode="aspectFill" wx:if="{{item.imgUrl}}" />
        <view class="cart-row-img cart-row-img-ph" wx:else>
          <van-icon name="photo-o" size="34rpx" color="var(--text-3)" />
        </view>
        <view class="cart-row-main flex-1">
          <view class="cart-row-name ellipsis">{{item.name}}</view>
          <view class="cart-row-price mono">¥{{item.realPriceText}}</view>
        </view>
        <view class="stepper">
          <view class="step-btn" data-id="{{item.id}}" data-pid="{{item.pid}}" data-delta="-1" bindtap="changeNum">
            <van-icon name="minus" size="24rpx" color="var(--accent)" />
          </view>
          <view class="step-num mono">{{item.num}}</view>
          <view class="step-btn" data-id="{{item.id}}" data-pid="{{item.pid}}" data-delta="1" bindtap="changeNum">
            <van-icon name="plus" size="24rpx" color="var(--accent)" />
          </view>
        </view>
      </view>
    </scroll-view>
    <view class="cart-panel-foot safe-bottom">
      <text class="cart-panel-total">合计 <text class="price">¥{{cartTotal}}</text></text>
      <view class="cart-panel-btn" bindtap="goConfirm">去结算</view>
    </view>
  </view>
</view>
