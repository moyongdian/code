/* 发表评价 —— 极简科技风 */
.order-line {
  display: flex; align-items: center; justify-content: space-between;
  padding: 10rpx 0; font-size: var(--fs-sm);
}
.order-line .muted { color: var(--text-3); }

.rate-title { font-size: var(--fs-lg); font-weight: 600; text-align: center; margin-bottom: var(--sp-3); }
.stars { display: flex; justify-content: center; }
.star { margin: 0 var(--sp-2); }
.rate-tip {
  text-align: center; font-size: var(--fs-sm); color: var(--accent);
  margin: var(--sp-2) 0 var(--sp-3);
}

.content {
  width: 100%; height: 220rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--border);
  border-radius: var(--r-md);
  padding: var(--sp-3);
  font-size: var(--fs-sm); line-height: 1.6; color: var(--text);
}
.content-ph { color: var(--text-3); }
.counter { text-align: right; font-size: var(--fs-xs); color: var(--text-3); margin-top: 10rpx; }
.actions { padding: var(--sp-4) var(--sp-3); }
