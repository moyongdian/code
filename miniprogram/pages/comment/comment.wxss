.card-title {
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 24rpx;
}

.order-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 26rpx;
}

.order-line .muted {
  color: #8c94a3;
}

.stars {
  display: flex;
  justify-content: center;
  margin-bottom: 12rpx;
}

.star {
  font-size: 72rpx;
  color: #e6e8ee;
  margin: 0 14rpx;
  transition: color 0.15s;
}

.star.on {
  color: #ffb020;
}

.star-tip {
  text-align: center;
  font-size: 25rpx;
  color: #8c94a3;
  margin-bottom: 24rpx;
}

.content {
  width: 100%;
  height: 220rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
  padding: 22rpx;
  font-size: 27rpx;
  line-height: 1.6;
}

.content-ph {
  color: #b8bdc8;
}

.counter {
  text-align: right;
  font-size: 22rpx;
  color: #b8bdc8;
  margin-top: 10rpx;
}

.actions {
  padding: 40rpx 24rpx;
}
