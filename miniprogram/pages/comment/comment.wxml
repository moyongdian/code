<!-- 发表评价：极简科技风 -->
<view class="page">
  <view wx:if="{{loading}}" class="loading">加载中…</view>

  <block wx:else>
    <view class="card" wx:if="{{order}}">
      <view class="order-line"><text class="muted">订单号</text><text class="mono">{{order.orderNo}}</text></view>
      <view class="order-line"><text class="muted">商家</text><text>{{order.business.name || '—'}}</text></view>
      <view class="order-line"><text class="muted">实付</text><text class="price">¥{{order.actual}}</text></view>
    </view>

    <view class="card">
      <view class="rate-title">本次用餐体验如何？</view>
      <view class="stars">
        <view wx:for="{{stars}}" wx:key="*this" class="star" data-star="{{item}}" bindtap="setStar">
          <van-icon name="{{item <= star ? 'star' : 'star-o'}}" size="72rpx"
                    color="{{item <= star ? '#fbbf24' : '#2c3850'}}" />
        </view>
      </view>
      <view class="rate-tip">{{starText}}</view>

      <textarea class="content" placeholder="说说菜品口味、配送速度、服务态度…"
                placeholder-class="content-ph" maxlength="200"
                value="{{content}}" bindinput="onContentInput" />
      <view class="counter mono">{{counter}}</view>
    </view>

    <view class="actions">
      <view class="btn btn-primary {{submitting ? 'disabled' : ''}}" bindtap="submit">
        {{submitting ? '提交中…' : '发表评价'}}
      </view>
    </view>
  </block>
</view>
