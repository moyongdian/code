/* 订单详情 —— 极简科技风 */
.status-head {
  position: relative;
  padding: var(--sp-5) var(--sp-3);
  background: var(--surface);
  border-bottom: 1rpx solid var(--border);
  overflow: hidden;
}
.status-glow {
  position: absolute; top: -180rpx; right: -100rpx;
  width: 400rpx; height: 400rpx; border-radius: 50%;
  background: radial-gradient(circle, rgba(34,211,238,0.20), transparent 65%);
}
.status-text { position: relative; font-size: var(--fs-2xl); font-weight: 700; }
.status-sub { position: relative; font-size: var(--fs-sm); color: var(--text-3); margin-top: 12rpx; }

.card-title { display: flex; align-items: center; font-size: var(--fs-md); font-weight: 600; margin-bottom: var(--sp-2); }
.card-title text { margin-left: 10rpx; }

.info-row { display: flex; align-items: flex-start; padding: 12rpx 0; font-size: var(--fs-sm); }
.info-label { width: 170rpx; color: var(--text-3); flex-shrink: 0; }
.info-value { flex: 1; color: var(--text); word-break: break-all; }
.info-value.link { color: var(--accent-2); }

.item { display: flex; align-items: center; padding: var(--sp-2) 0; }
.item-img { width: 100rpx; height: 100rpx; border-radius: var(--r-sm); background: var(--surface-2); flex-shrink: 0; }
.item-img-ph { display: flex; align-items: center; justify-content: center; }
.item-main { margin-left: var(--sp-2); min-width: 0; }
.item-name { font-size: var(--fs-sm); font-weight: 600; }
.item-qty { font-size: var(--fs-xs); color: var(--text-3); margin-top: 8rpx; }
.item-price { display: flex; flex-direction: column; align-items: flex-end; }
.item-price .price { font-size: var(--fs-sm); }

.fee-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 12rpx 0; font-size: var(--fs-sm); color: var(--text-2);
}
.fee-cut { color: var(--accent); }
.fee-free { color: var(--success); }
.fee-row.total { font-size: var(--fs-md); font-weight: 700; color: var(--text); }
.fee-row.total .price { font-size: var(--fs-xl); }

.actions { display: flex; justify-content: flex-end; padding: 0 var(--sp-3) var(--sp-5); }
.a-btn {
  height: 72rpx; padding: 0 36rpx; margin-left: var(--sp-2);
  border-radius: var(--r-pill);
  font-size: var(--fs-sm); font-weight: 600;
  display: flex; align-items: center; justify-content: center;
}
.a-btn.ghost { border: 1rpx solid var(--border-strong); color: var(--text-2); }
.a-btn.accent { border: 1rpx solid rgba(34,211,238,0.35); color: var(--accent); }
.a-btn.primary { background: var(--grad-accent); color: #04121a; }
