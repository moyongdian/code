.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 5;
}

.search-box {
  flex: 1;
  height: 68rpx;
  background: #f2f3f5;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}

.search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 27rpx;
}

.search-ph {
  color: #b8bdc8;
}

.search-clear {
  color: #b8bdc8;
  font-size: 26rpx;
  padding: 0 6rpx;
}

.search-btn {
  color: #ff5a1f;
  font-size: 28rpx;
  margin-left: 20rpx;
  font-weight: 600;
}

.count {
  padding: 16rpx 32rpx;
  font-size: 24rpx;
  color: #8c94a3;
}

.prod {
  display: flex;
  background: #fff;
  margin: 0 24rpx 16rpx;
  border-radius: 20rpx;
  padding: 22rpx;
  box-shadow: 0 2rpx 12rpx rgba(24, 33, 56, 0.04);
}

.prod-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 14rpx;
  background: #f2f3f5;
  flex-shrink: 0;
}

.prod-img-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
}

.prod-main {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.prod-name {
  font-size: 30rpx;
  font-weight: 700;
}

.prod-desc {
  font-size: 23rpx;
  color: #a3a9b5;
  margin-top: 8rpx;
}

.prod-shop {
  font-size: 23rpx;
  color: #ff8a4c;
  margin-top: 10rpx;
}

.prod-bottom {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.prod-price {
  display: flex;
  align-items: baseline;
}

.prod-price .price {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.add-btn {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff8a4c, #ff5a1f);
  color: #fff;
  font-size: 36rpx;
  line-height: 50rpx;
  text-align: center;
}

.empty-tip {
  font-size: 24rpx;
  color: #c9ced8;
  margin-top: 16rpx;
}
