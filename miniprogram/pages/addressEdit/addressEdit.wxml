<view class="page">
  <view class="card">
    <view class="field">
      <text class="field-label">联系人 <text class="req">*</text></text>
      <input class="field-input" placeholder="收货人姓名" placeholder-class="field-input-placeholder"
             value="{{form.user}}" data-field="user" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="field-label">联系电话 <text class="req">*</text></text>
      <input class="field-input" type="number" maxlength="11" placeholder="11 位手机号"
             placeholder-class="field-input-placeholder"
             value="{{form.phone}}" data-field="phone" bindinput="onInput" />
    </view>
  </view>

  <view class="card">
    <view class="field-label block">详细地址 <text class="req">*</text></view>
    <textarea class="addr-input" placeholder="宿舍楼栋、门牌号等，例如：东区 3 号宿舍楼 502"
              placeholder-class="field-input-placeholder" maxlength="120"
              value="{{form.address}}" data-field="address" bindinput="onInput" />
  </view>

  <view class="actions">
    <button class="btn-primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">
      {{submitting ? '保存中…' : (isEdit ? '保存修改' : '添加地址')}}
    </button>
  </view>
</view>
