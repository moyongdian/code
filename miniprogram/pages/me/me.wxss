.hero {
  background: linear-gradient(135deg, #ff8a4c, #ff5a1f);
  padding: 40rpx 32rpx 0;
  color: #fff;
}

.hero-user {
  display: flex;
  align-items: center;
}

.avatar {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  background: #fff;
  flex-shrink: 0;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
}

.avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  font-weight: 700;
  color: #ff5a1f;
}

.hero-info {
  margin-left: 24rpx;
  flex: 1;
  overflow: hidden;
}

.hero-name {
  font-size: 38rpx;
  font-weight: 700;
}

.hero-sub {
  font-size: 24rpx;
  opacity: 0.92;
  margin-top: 10rpx;
}

.order-bar {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  margin-top: 36rpx;
  padding: 26rpx 0;
  transform: translateY(30rpx);
  box-shadow: 0 6rpx 24rpx rgba(255, 90, 31, 0.16);
}

.order-entry {
  flex: 1;
  text-align: center;
}

.order-icon {
  position: relative;
  display: inline-block;
  font-size: 42rpx;
  line-height: 1;
}

.badge {
  position: absolute;
  top: -10rpx;
  right: -20rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #ff4d2d;
  color: #fff;
  font-size: 19rpx;
  line-height: 30rpx;
  text-align: center;
}

.order-label {
  display: block;
  font-size: 23rpx;
  color: #4a5163;
  margin-top: 12rpx;
}

.menu {
  background: #fff;
  margin: 20rpx 24rpx 0;
  border-radius: 20rpx;
  overflow: hidden;
}

.menu:first-of-type {
  margin-top: 56rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 26rpx;
  border-bottom: 1rpx solid #f7f8fa;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 34rpx;
  width: 52rpx;
}

.menu-label {
  flex: 1;
  font-size: 29rpx;
}

.menu-arrow {
  font-size: 38rpx;
  color: #c9ced8;
}

.logout {
  margin: 40rpx 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
  text-align: center;
  padding: 30rpx 0;
  font-size: 29rpx;
  color: #ff4d2d;
}

.version {
  text-align: center;
  font-size: 22rpx;
  color: #b8bdc8;
  padding: 40rpx 0 30rpx;
}
