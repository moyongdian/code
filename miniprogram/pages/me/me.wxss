/* 我的 —— 极简科技风 */
.page { padding-bottom: 60rpx; }

/* ---------- 头部 ---------- */
.hero {
  position: relative;
  padding: var(--sp-5) var(--sp-3) var(--sp-4);
  overflow: hidden;
}
/* 主色光晕：科技感来源 */
.hero-glow {
  position: absolute;
  top: -160rpx; right: -120rpx;
  width: 420rpx; height: 420rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(34,211,238,0.22), transparent 65%);
}
.hero-user { position: relative; display: flex; align-items: center; }

.avatar {
  width: 120rpx; height: 120rpx;
  border-radius: 50%;
  background: var(--surface-2);
  flex-shrink: 0;
  border: 2rpx solid rgba(34,211,238,0.35);
}
.avatar-ph { display: flex; align-items: center; justify-content: center; }

.hero-info { margin-left: var(--sp-3); min-width: 0; }
.hero-name { font-size: var(--fs-xl); font-weight: 700; }
.hero-sub { font-size: var(--fs-sm); color: var(--text-3); margin-top: 8rpx; }

.hero-role {
  display: flex; align-items: center;
  padding: 8rpx 16rpx;
  border-radius: var(--r-pill);
  background: var(--accent-soft);
  border: 1rpx solid rgba(34,211,238,0.3);
  flex-shrink: 0;
}
.hero-role text {
  margin-left: 6rpx;
  font-size: var(--fs-xs);
  color: var(--accent);
}

/* ---------- 订单统计卡片 ---------- */
.stat-card {
  margin: calc(var(--sp-3) * -1) var(--sp-3) var(--sp-3);
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: var(--r-lg);
  padding: var(--sp-3);
  position: relative;
}
.stat-head {
  display: flex; align-items: center; justify-content: space-between;
  padding-bottom: var(--sp-2);
  border-bottom: 1rpx solid var(--border);
}
.stat-title { font-size: var(--fs-md); font-weight: 600; }
.stat-all { display: flex; align-items: center; }
.stat-all text { font-size: var(--fs-sm); color: var(--text-3); margin-right: 4rpx; }

.stat-row { display: flex; padding-top: var(--sp-3); }
.stat-item {
  flex: 1;
  display: flex; flex-direction: column; align-items: center;
}
.stat-icon { position: relative; }
.stat-label {
  margin-top: 12rpx;
  font-size: var(--fs-xs);
  color: var(--text-3);
}

/* ---------- 功能列表 ---------- */
.menu {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: var(--r-lg);
  margin: 0 var(--sp-3) var(--sp-3);
  overflow: hidden;
}
.menu-item {
  display: flex; align-items: center;
  padding: var(--sp-3);
  border-bottom: 1rpx solid var(--border);
}
.menu-item:last-child { border-bottom: none; }
.menu-label {
  flex: 1;
  margin-left: var(--sp-3);
  font-size: var(--fs-md);
  color: var(--text);
}

/* ---------- 退出 ---------- */
.logout {
  display: flex; align-items: center; justify-content: center;
  margin: var(--sp-4) var(--sp-3) 0;
  height: 92rpx;
  background: var(--surface);
  border: 1rpx solid rgba(248,113,113,0.25);
  border-radius: var(--r-lg);
}
.logout text {
  margin-left: 10rpx;
  font-size: var(--fs-md);
  color: var(--danger);
  font-weight: 600;
}

.version {
  text-align: center;
  font-size: 18rpx;
  letter-spacing: 3rpx;
  color: var(--text-3);
  padding: var(--sp-5) 0 var(--sp-3);
  opacity: 0.7;
}
